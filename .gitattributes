# Auto detect text files and perform LF normalization
* text=auto
scripts/windows_ci/native_business_window.json text eol=lf
.github/workflows/native-business-trial-once.yml text eol=lf
# Acceptance fingerprints bind raw test bytes to Git blobs on every platform.
tests/*.py text eol=lf
# Preserve the exact restored Library source bytes on every platform.
docs/sources/V1/*.md -text

# The assembler binds its source and asset lock to raw Git blob bytes.
/scripts/windows_portable/build.py -text
/scripts/windows_portable/payload.py -text
/scripts/windows_portable/runtime-assets.json -text
