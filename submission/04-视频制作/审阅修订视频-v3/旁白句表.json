[
  {
    "id": "S01",
    "start": 0,
    "end": 8,
    "text": "一家企业的成长，需要多少次协作？",
    "duration": 4.223,
    "speech_start": 0.15,
    "speech_end": 4.373
  },
  {
    "id": "S02",
    "start": 8,
    "end": 15,
    "text": "空间、设备和岗位分散，办理需要跨入口协调。",
    "duration": 6.013,
    "speech_start": 8.15,
    "speech_end": 14.163
  },
  {
    "id": "S03",
    "start": 15,
    "end": 22,
    "text": "园合，从企业目标出发，把分散能力组织成连续服务。",
    "duration": 6.507,
    "speech_start": 15.15,
    "speech_end": 21.657
  },
  {
    "id": "S04",
    "start": 22,
    "end": 30,
    "text": "以企业授权的需求和服务更新为依据，提出机会，明确待核条件。",
    "duration": 7.517,
    "speech_start": 22.15,
    "speech_end": 29.667
  },
  {
    "id": "S05",
    "start": 30,
    "end": 38,
    "text": "四十人的技术交流，先核对时段、预算和必需设备。",
    "duration": 6.127,
    "speech_start": 30.15,
    "speech_end": 36.277
  },
  {
    "id": "S06",
    "start": 38,
    "end": 47,
    "text": "模型组织候选，规则核对条件；岗位承接任务，回执确认结果。",
    "duration": 7.717,
    "speech_start": 38.15,
    "speech_end": 45.867
  },
  {
    "id": "S07",
    "start": 47,
    "end": 55,
    "text": "先排除容量不足和缺少设备的方案，再解释可行候选与费用构成。",
    "duration": 7.502,
    "speech_start": 47.15,
    "speech_end": 54.652
  },
  {
    "id": "S08",
    "start": 55,
    "end": 63,
    "text": "预检后，核对当前资源状态，由企业明确确认组合。",
    "duration": 6.372,
    "speech_start": 55.15,
    "speech_end": 61.522
  },
  {
    "id": "S09",
    "start": 63,
    "end": 70,
    "text": "专员派发任务，执行者本人接单，责任随事项传递。",
    "duration": 6.247,
    "speech_start": 63.15,
    "speech_end": 69.397
  },
  {
    "id": "S10",
    "start": 70,
    "end": 76,
    "text": "准备结果经回执核对，进入事项档案。",
    "duration": 4.593,
    "speech_start": 70.15,
    "speech_end": 74.743
  },
  {
    "id": "S11",
    "start": 76,
    "end": 80,
    "text": "再看一项独立的变更案例。",
    "duration": 3.173,
    "speech_start": 76.15,
    "speech_end": 79.323
  },
  {
    "id": "S12",
    "start": 80,
    "end": 88,
    "text": "人数减半、时段后移、预算收紧，新条件先进入复验。",
    "duration": 6.797,
    "speech_start": 80.15,
    "speech_end": 86.947
  },
  {
    "id": "S13",
    "start": 88,
    "end": 96,
    "text": "系统区分保留、复验和候选替换，让有效安排继续沿用。",
    "duration": 6.862,
    "speech_start": 88.15,
    "speech_end": 95.012
  },
  {
    "id": "S14",
    "start": 96,
    "end": 104,
    "text": "原场地容量仍满足，企业按费用偏好选择会议室B。",
    "duration": 6.162,
    "speech_start": 96.15,
    "speech_end": 102.312
  },
  {
    "id": "S15",
    "start": 104,
    "end": 110,
    "text": "设备保留，新时段和接待安排重新确认。",
    "duration": 5.018,
    "speech_start": 104.15,
    "speech_end": 109.168
  },
  {
    "id": "S16",
    "start": 110,
    "end": 117,
    "text": "签到遗漏，回执补充后交企业核对。",
    "duration": 4.423,
    "speech_start": 110.15,
    "speech_end": 114.573
  },
  {
    "id": "S17",
    "start": 117,
    "end": 124,
    "text": "资料交接要求增加，事项重开，原依据保留。",
    "duration": 5.748,
    "speech_start": 117.15,
    "speech_end": 122.898
  },
  {
    "id": "S18",
    "start": 124,
    "end": 130,
    "text": "新回执形成新归档，旧版本仍能回看。",
    "duration": 4.903,
    "speech_start": 124.15,
    "speech_end": 129.053
  },
  {
    "id": "S19",
    "start": 130,
    "end": 138,
    "text": "同一机制延伸到入驻：空间、资料、网络与物业各有责任。",
    "duration": 6.887,
    "speech_start": 130.15,
    "speech_end": 137.037
  },
  {
    "id": "S20",
    "start": 138,
    "end": 145,
    "text": "研发服务核对样件、能力、资质与报告要求。",
    "duration": 5.543,
    "speech_start": 138.15,
    "speech_end": 143.693
  },
  {
    "id": "S21",
    "start": 145,
    "end": 152,
    "text": "政策服务核对来源与缺证据，再交专业岗位复核。",
    "duration": 5.697,
    "speech_start": 145.15,
    "speech_end": 150.847
  },
  {
    "id": "S22",
    "start": 152,
    "end": 161,
    "text": "工作台连接园区服务端，模型给建议，业务系统和授权人员确认结果。",
    "duration": 8.196,
    "speech_start": 152.15,
    "speech_end": 160.346
  },
  {
    "id": "S23",
    "start": 161,
    "end": 170,
    "text": "第二园区复用服务结构，映射本地条件后运行验收。",
    "duration": 5.957,
    "speech_start": 161.15,
    "speech_end": 167.107
  },
  {
    "id": "S24",
    "start": 170,
    "end": 180,
    "text": "园合，让园区的每一种能力，汇聚到企业的每一次成长。",
    "duration": 6.437,
    "speech_start": 170.15,
    "speech_end": 176.587
  }
]