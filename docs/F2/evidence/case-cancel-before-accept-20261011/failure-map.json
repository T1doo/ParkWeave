      "direct_original_exception": "psycopg.errors.RaiseException: schema 28 prerequisite or retained schema 29 required",
      "module_recheck": "final-facts",
      "root_cause": "Collected old migration-029 repeat oracle at schema 30; the actual retained SQL is migration-029, despite traceback source line having changed to 030 after file edit."
    },
    "C2": {
      "basis": "DIRECT_ORIGINAL_EXCEPTION_AND_QUERY",
      "change": "Test INSERT31 remains a genuine future version and preserves migration-025 future-version refusal with a valid original receipt.",
      "direct_original_exception": "psycopg.errors.UniqueViolation: schema_version_pkey; Key (version)=(30) already exists.",
      "module_recheck": "final-facts",
      "root_cause": "Collected old future-version oracle INSERTed already-existing schema version 30. Actual query and exception record version 30, although linecache displays corrected INSERT31."
    },
    "C3": {
      "basis": "DIRECT_ORIGINAL_EXCEPTION_BASELINE_REPRO_AND_INDEPENDENT_SOURCE_ORACLE",
      "change": "Existing ADOPT/CAS with current plan revision and local_revision=True explicitly binds changed access source before P3. Production registered dependency code unchanged; same original flow actually FAILed on e40 baseline.",
      "direct_original_exception": "AssertionError: adapter sources, binding, reported obstacle or predecessors need recheck;409 !=200",
      "module_recheck": "template-current-corrected",
      "root_cause": "Template history fixture adopted its plan, then added Run assignments without explicit local ADOPT. Existing registered access dependency invalidated P3/P4 and P3 correctly returned409."
    },
    "C4": {
      "basis": "DIRECT_ORIGINAL_SUBPROCESS_STDERR_IN_JUNIT",
      "change": "Installed setuptools==80.9.0 and wheel==0.45.1 in the existing task venv, without changing source, credentials, network configuration or fixture permissions.",
      "direct_original_exception": "ModuleNotFoundError: No module named 'setuptools'",
      "module_recheck": "installed-process-rerun",
      "root_cause": "The task venv lacked setuptools==80.9.0, required by the actual wheel-building subprocess."
    },
    "C5": {
      "basis": "SHARED_STARTUP_EXCEPTION_DIRECT; MISSING_PROJECT_IMPORT_ROOT_CAUSE_INFERRED_FROM_SOURCE_ENVIRONMENT_AND_INSTALLATION_RECHECK",
      "change": "Editable current project installed using --no-build-isolation --no-deps in the existing venv; full worker/auth/opportunity modules subsequently run. No source or auth guard change for this setup problem.",
      "direct_original_exception": "RuntimeError: API exited during start at tests/test_worker_gateway.py:33",
      "limitation": "The original 39 child api.log files under pytest-11 are no longer present. The original JUnit/stdout records API exit, not the child ModuleNotFoundError traceback. A prior tool read observed missing parkweave, but no durable stderr copy was saved; the archive does not manufacture one or claim each stderr directly proved.",
      "module_recheck": "installed-process-rerun",
      "root_cause": "Shared child API startup failure, attributed to ParkWeave not yet installed for the minimal-environment Python subprocess. Pytest pythonpath=src only made in-process imports work."
    }
