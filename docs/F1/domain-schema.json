            "executor": {
              "const": "TRUSTED_LOCAL",
              "default": "TRUSTED_LOCAL",
              "title": "Executor",
              "type": "string"
            },
            "effect": {
              "const": "LOCAL_RECORD",
              "default": "LOCAL_RECORD",
              "title": "Effect",
              "type": "string"
            },
            "idempotency": {
              "const": "SCOPED_KEY_AND_FINGERPRINT",
              "default": "SCOPED_KEY_AND_FINGERPRINT",
              "title": "Idempotency",
              "type": "string"
            },
            "success_scope": {
              "const": "LOCAL_CASE_CREATED",
              "default": "LOCAL_CASE_CREATED",
              "title": "Success Scope",
              "type": "string"
