        "SourceRef": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 120,
              "minLength": 1,
              "title": "Id",
              "type": "string"
            },
            "kind": {
              "enum": [
                "SYNTHETIC",
                "PUBLIC",
                "AUTHORIZED_REAL"
              ],
              "title": "Kind",
              "type": "string"
            },
            "revision": {
              "maxLength": 120,
              "minLength": 1,
              "title": "Revision",
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "revision"
          ],
          "title": "SourceRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "parkweave-domain/0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "service_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Service Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "owner_org_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Owner Org Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "service_kind": {
          "const": "LOCAL_INTAKE",
          "title": "Service Kind",
          "type": "string"
        },
        "eligibility": {
          "const": "NOT_REQUIRED",
          "title": "Eligibility",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "reviewer_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Reviewer Id",
          "type": "string"
        },
        "publication": {
          "const": "REVIEWED_SYNTHETIC",
          "title": "Publication",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ActionSpec"
        },
        "completion_checks": {
          "items": {
            "const": "LOCAL_RECORD_EXISTS",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Completion Checks",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "service_id",
        "revision",
        "owner_org_id",
        "title",
        "service_kind",
        "eligibility",
        "source_refs",
        "reviewer_id",
        "publication",
        "action",
        "completion_checks"
