{
  "version": "parkweave-domain/1.0-draft",
  "origin": "V1 minimum required shapes plus legacy0.1 projections; bounded trusted capabilities only; structural validation is not publication/approval",
  "schemas": {
    "Intake": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "parkweave-domain/0.1",
          "default": "parkweave-domain/0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "action": {
          "default": "case.create",
          "enum": [
            "case.create",
            "fault.record",
            "facts.assess"
          ],
          "title": "Action",
          "type": "string"
        },
        "goal": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "source": {
          "const": "SYNTHETIC",
          "default": "SYNTHETIC",
          "title": "Source",
          "type": "string"
        },
        "fact_fields": {
          "items": {
            "enum": [
              "region",
              "employees",
              "service_need"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Fact Fields",
          "type": "array"
        }
      },
      "required": [
        "goal"
      ],
      "title": "Intake",
      "type": "object"
    },
    "ServiceSpec": {
